# Supabase Configuration
# Replace these placeholders with your actual Supabase project credentials from Project Settings -> API

# Publicly accessible URL for your Supabase project (Client & Server)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Public anonymous key for client-side API calls (Safe to expose in browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...your-anon-key-here

# Optional: Service role key for administrative backend operations (Keep secret, never expose on client)
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...your-service-role-key-here
